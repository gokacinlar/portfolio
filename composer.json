{
    "autoload": {
        "psr-4": {
            "App\\": "src/php/"
        }
    },
    "require": {
        "vlucas/phpdotenv": "^5.6",
        "guzzlehttp/guzzle": "^7.10",
        "voku/anti-xss": "^4.1",
        "filp/whoops": "^2.18",
        "dconco/phpspa": "^2.0"
    },
    "scripts": {
        "test": [
            "phpunit"
        ]
    },
    "require-dev": {
        "roave/security-advisories": "dev-latest",
        "phpstan/phpstan": "^2.2",
        "icanhazstring/composer-unused": "^0.9.6",
        "phpro/grumphp": "^2.23",
        "shipmonk/dead-code-detector": "^1.3",
        "phpunit/phpunit": "^11.5"
    },
    "config": {
        "allow-plugins": {
            "phpro/grumphp": true
        }
    }
}