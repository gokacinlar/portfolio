{
  "name": "new-portfolio",
  "version": "1.1.0",
  "description": "Derviş's Personel Website",
  "main": "index.js",
  "scripts": {
    "build": "webpack --config webpack.config.js --mode production",
    "dev": "webpack --config webpack.config.js --mode development",
    "live": "webpack serve --config webpack.config.js --mode development",
    "toc": "i18next-resources-for-ts toc -i ./src/locales/en ./src/locales/tr -o ./src/types/resources.ts",
    "toc:interface": "i18next-resources-for-ts interface -i ./src/locales/en -o ./src/types/resources.d.ts",
    "composer:install": "composer install",
    "generate:sitemap": "npx tsx ./src/scripts/sitemap.ts",
    "generate:robotstxt": "npx tsx ./src/scripts/robotsTxt.ts"
  },
  "author": "Derviş Öksüzoğlu",
  "license": "CC0-1.0",
  "devDependencies": {
    "@types/bootstrap": "^5.2.10",
    "@types/grecaptcha": "^3.0.9",
    "@types/jquery": "^3.5.32",
    "@types/node": "^24.10.0",
    "@types/scrollreveal": "^0.0.11",
    "@types/toastify-js": "^1.12.4",
    "@types/validator": "^13.15.2",
    "autoprefixer": "^10.4.21",
    "copy-webpack-plugin": "^13.0.0",
    "csp-html-webpack-plugin": "^5.1.0",
    "css-loader": "^7.1.2",
    "css-minimizer-webpack-plugin": "^7.0.2",
    "dotenv-webpack": "^8.1.1",
    "eslint": "^9.28.0",
    "generate-robotstxt": "^8.0.3",
    "html-webpack-plugin": "^5.6.3",
    "i18next-resources-for-ts": "^1.8.0",
    "mini-css-extract-plugin": "^2.9.2",
    "postcss-loader": "^8.1.1",
    "sass": "^1.89.2",
    "sass-loader": "^16.0.5",
    "style-loader": "^4.0.0",
    "terser-webpack-plugin": "^5.3.14",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tslib": "^2.8.1",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "webpack": "^5.99.9",
    "webpack-cli": "^6.0.1",
